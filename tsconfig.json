{
    "$schema": "https://json.schemastore.org/tsconfig",
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "lib"],
    "compilerOptions": {
        "target": "es2023",
        "lib": ["es2023"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "noEmit": true
    }
}
